# Web / persistence
PORT=8080
TZ=Asia/Taipei
DB_PATH=/data/crypto_lab.db
LOG_LEVEL=INFO
ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Market scanner — signals and learning ONLY use fully closed candles
SCAN_INTERVAL_SEC=30
SCAN_SYMBOLS_PER_CYCLE=36
UNIVERSE_MIN_USDT_VOLUME=1500000
UNIVERSE_MAX_SYMBOLS=280
MIN_SYMBOL_AGE_DAYS=3
MARKET_TIMEOUT_SEC=12
CLOSED_CANDLE_SAFETY_MS=2500
BTC_MACRO_REFRESH_SEC=300

# Independent paper account per strategy
INITIAL_PAPER_EQUITY=10000
PAPER_TAKER_FEE=0.0006
PAPER_MAKER_FEE=0.0002
PAPER_SLIPPAGE_BPS=4
PAPER_STRESS_SLIPPAGE_BPS=12

# Hard NON-LEARNABLE paper risk ceilings
HARD_MAX_RISK_PER_TRADE=0.02
HARD_MAX_LEVERAGE=5
HARD_MAX_OPEN_POSITIONS=8
HARD_MAX_SYMBOL_EXPOSURE_PCT=0.40
HARD_MAX_TOTAL_EXPOSURE_PCT=2.25
HARD_STRATEGY_DAILY_LOSS_PCT=0.06
HARD_SYSTEM_DAILY_LOSS_PCT=0.10
HARD_STRATEGY_DRAWDOWN_PCT=0.28
HARD_MIN_STOP_PCT=0.0020
HARD_MAX_STOP_PCT=0.12

# Champion / Challenger learning
LEARNING_ENABLED=true
LEARNING_INTERVAL_HOURS=24
LEARNING_MIN_TRADES=40
LEARNING_RECENT_WINDOW=180
CHALLENGER_MIN_TRADES=30
CHALLENGER_MIN_DAYS=7
MAX_LEARNING_CHANGES=2
FINAL_MIN_TRADES=250
FINAL_MIN_DAYS=45
FINAL_MIN_PF=1.25
FINAL_MIN_STRESS_PF=1.10
FINAL_MAX_DD_PCT=0.10
FINAL_MIN_ROBUST_WINDOWS=0.75
FINAL_MAX_SYMBOL_PROFIT_SHARE=0.35
FINAL_MIN_SYMBOLS=5

# Post-trade exit laboratory. Uses only the SAME strategy's own fully-closed candle path.
POST_TRADE_ENABLED=true
POST_TRADE_FOLLOW_BARS=16
POST_TRADE_MIN_STUDIES=20
POST_TRADE_MIN_SIGNAL_RATIO=0.30

# Bitget market + future live execution
BITGET_BASE_URL=https://api.bitget.com
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_MARGIN_MODE=isolated
BITGET_POSITION_MODE=one_way_mode
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Real-money deployment gate. Dashboard master switch + per-strategy manual approval are ALSO required.
LIVE_TRADING_ALLOWED=false
LIVE_PARTIAL_TP_ENABLED=true
LIVE_SYNC_INTERVAL_SEC=20
LIVE_AVAILABLE_BALANCE_BUFFER=0.90
LIVE_MAX_ENTRY_DRIFT_BPS=35

# Shared-account portfolio allocator: live size is NOT copied from paper quantity.
LIVE_BASE_RISK_PCT=0.015
LIVE_MAX_RISK_PCT=0.020
LIVE_MAX_ORDER_EQUITY_PCT=0.85
LIVE_MAX_TOTAL_NOTIONAL_MULTIPLE=4.0
LIVE_MAX_CONCURRENT_POSITIONS=8
LIVE_MIN_FREE_MARGIN_PCT=0.12

# Protection Guardian
LIVE_PROTECTION_RETRY=4
LIVE_PROTECTION_VERIFY_SEC=20
LIVE_EMERGENCY_CLOSE_ON_PROTECTION_FAILURE=true
LIVE_TRAIL_SYNC_ENABLED=true

# CoinGlass V4 paid API
COINGLASS_ENABLED=true
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_EXCHANGE=Binance
COINGLASS_CACHE_SEC=300
COINGLASS_TOP_SYMBOLS=100
