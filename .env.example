# Web / persistence
PORT=8080
TZ=Asia/Taipei
DB_PATH=/data/crypto_lab.db
LOG_LEVEL=INFO
ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Market scanner
SCAN_INTERVAL_SEC=45
SCAN_SYMBOLS_PER_CYCLE=30
UNIVERSE_MIN_USDT_VOLUME=3000000
UNIVERSE_MAX_SYMBOLS=250
MIN_SYMBOL_AGE_DAYS=7
MARKET_TIMEOUT_SEC=12
REGIME_REFRESH_SEC=300

# Independent paper account per strategy (champion); challengers use shadow accounts
INITIAL_PAPER_EQUITY=10000
PAPER_TAKER_FEE=0.0006
PAPER_MAKER_FEE=0.0002
PAPER_SLIPPAGE_BPS=4
PAPER_STRESS_SLIPPAGE_BPS=12

# Hard, NON-LEARNABLE risk ceilings
HARD_MAX_RISK_PER_TRADE=0.02
HARD_MAX_LEVERAGE=5
HARD_MAX_OPEN_POSITIONS=8
HARD_MAX_SYMBOL_EXPOSURE_PCT=0.35
HARD_MAX_TOTAL_EXPOSURE_PCT=2.0
HARD_STRATEGY_DAILY_LOSS_PCT=0.05
HARD_SYSTEM_DAILY_LOSS_PCT=0.08
HARD_STRATEGY_DRAWDOWN_PCT=0.25
HARD_MIN_STOP_PCT=0.0025
HARD_MAX_STOP_PCT=0.10

# Champion / Challenger learning
LEARNING_ENABLED=true
LEARNING_INTERVAL_HOURS=24
LEARNING_MIN_TRADES=50
LEARNING_RECENT_WINDOW=160
CHALLENGER_MIN_TRADES=30
CHALLENGER_MIN_DAYS=7
MAX_LEARNING_CHANGES=2
FINAL_MIN_TRADES=250
FINAL_MIN_DAYS=45
FINAL_MIN_PF=1.25
FINAL_MIN_STRESS_PF=1.10
FINAL_MAX_DD_PCT=0.10
FINAL_MIN_ROBUST_WINDOWS=0.75
FINAL_MAX_SYMBOL_PROFIT_SHARE=0.35
FINAL_MIN_SYMBOLS=5

# Bitget market + future live execution
BITGET_BASE_URL=https://api.bitget.com
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_MARGIN_MODE=isolated
BITGET_POSITION_MODE=one_way_mode
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Deployment permission for real money. Keep false during learning.
# Even when true, live orders still require: strategy FINAL + auto live_eligible + dashboard master switch ON.
LIVE_TRADING_ALLOWED=false
LIVE_PARTIAL_TP_ENABLED=true
LIVE_MAX_STRATEGY_NOTIONAL_USDT=2500
LIVE_MAX_ORDER_NOTIONAL_USDT=1000
LIVE_SYNC_INTERVAL_SEC=30
LIVE_AVAILABLE_BALANCE_BUFFER=0.90
LIVE_MAX_ENTRY_DRIFT_BPS=35

# CoinGlass V4 paid API
COINGLASS_ENABLED=true
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_EXCHANGE=Binance
COINGLASS_CACHE_SEC=300
COINGLASS_TOP_SYMBOLS=80
