PORT=8080
TZ=Asia/Taipei
DB_PATH=/data/crypto_lab.db

# Scanner
SCAN_INTERVAL_SEC=60
SCAN_SYMBOLS_PER_CYCLE=24
UNIVERSE_MIN_USDT_VOLUME=2000000
MAX_OPEN_POSITIONS_PER_STRATEGY=4

# Each strategy starts with its own 10,000U paper account
INITIAL_PAPER_EQUITY=10000
PAPER_TAKER_FEE=0.0006
PAPER_SLIPPAGE_BPS=4
PAPER_MAX_LEVERAGE=3

# Bitget public market data works without keys.
BITGET_BASE_URL=https://api.bitget.com
BITGET_PRODUCT_TYPE=USDT-FUTURES

# Keep private keys empty during research/paper stages.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# CoinGlass paid API (optional but recommended for liquidation strategy)
COINGLASS_ENABLED=true
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_EXCHANGE=Binance

# Conservative learning governor
LEARNING_ENABLED=true
LEARNING_MIN_TRADES=60
LEARNING_INTERVAL_HOURS=24
LEARNING_RECENT_WINDOW=120

# Hard safety lock. FINAL strategy is only "eligible"; it still cannot place a real order unless both are set.
LIVE_TRADING_ENABLED=false
FINAL_LIVE_UNLOCK_TOKEN=

# Optional API admin token for manual learning trigger
ADMIN_TOKEN=
